{
  "uid": "marketlake-market",
  "title": "Market",
  "description": "Live crypto market data from the lakehouse: Coinbase \u2192 Redpanda \u2192 Spark \u2192 Iceberg, queried through Trino.",
  "tags": [
    "marketlake"
  ],
  "timezone": "utc",
  "refresh": "10s",
  "schemaVersion": 41,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "symbol",
        "label": "Symbol",
        "type": "query",
        "datasource": {
          "type": "trino-datasource",
          "uid": "trino"
        },
        "query": {
          "refId": "TrinoDataSource-QueryVariable",
          "rawSQL": "SELECT DISTINCT symbol FROM lake.silver.trades WHERE event_ts > current_timestamp - INTERVAL '1' DAY ORDER BY 1"
        },
        "refresh": 1,
        "current": {
          "text": "BTC-USD",
          "value": "BTC-USD"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Last price",
      "description": "",
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT CAST(price AS double) AS price\nFROM lake.silver.trades\nWHERE symbol = '$symbol' AND event_ts > current_timestamp - INTERVAL '1' HOUR\nORDER BY event_ts DESC, trade_id DESC\nLIMIT 1",
          "format": 1
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "VWAP (time range)",
      "description": "Volume-weighted average price over the dashboard's time range, from gold.bars_1m.",
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT CAST(sum(notional) / sum(volume) AS double) AS vwap\nFROM lake.gold.bars_1m\nWHERE symbol = '$symbol' AND $__timeFilter(window_start)",
          "format": 1
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Trades (time range)",
      "description": "",
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT count(*) AS trades\nFROM lake.silver.trades\nWHERE symbol = '$symbol' AND $__timeFilter(event_ts)",
          "format": 1
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Taker buy share",
      "description": "Share of volume where the aggressor bought. Coinbase reports the maker side; the ingestor flips it.",
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT CAST(sum(buy_volume) / sum(volume) AS double) AS buy_share\nFROM lake.gold.bars_1m\nWHERE symbol = '$symbol' AND $__timeFilter(window_start)",
          "format": 1
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "candlestick",
      "title": "1-minute bars",
      "description": "gold.bars_1m, written by Spark Structured Streaming once each window closes (30s event-time watermark).",
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT window_start AS time,\n       CAST(open AS double) AS open, CAST(high AS double) AS high,\n       CAST(low AS double) AS low, CAST(close AS double) AS close,\n       CAST(volume AS double) AS volume\nFROM lake.gold.bars_1m\nWHERE symbol = '$symbol' AND $__timeFilter(window_start)\nORDER BY 1",
          "format": 1
        }
      ],
      "options": {
        "mode": "candles+volume",
        "candleStyle": "candles",
        "colorStrategy": "open-close",
        "colors": {
          "up": "green",
          "down": "red"
        },
        "includeAllFields": false,
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "volume"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Trades per second by taker side",
      "description": "From silver.trades, in 10-second buckets.",
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT $__timeGroup(event_ts, '10s') AS time,\n       count_if(taker_side = 'buy') / 10e0 AS buys,\n       count_if(taker_side = 'sell') / 10e0 AS sells\nFROM lake.silver.trades\nWHERE symbol = '$symbol' AND $__timeFilter(event_ts)\nGROUP BY 1\nORDER BY 1",
          "format": 1
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: trades/s",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "buys"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sells"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Close vs VWAP per minute",
      "description": "",
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT window_start AS time,\n       CAST(close AS double) AS close,\n       CAST(vwap AS double) AS vwap\nFROM lake.gold.bars_1m\nWHERE symbol = '$symbol' AND $__timeFilter(window_start)\nORDER BY 1",
          "format": 1
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "lineWidth": 2,
            "insertNulls": 90000
          }
        },
        "overrides": []
      }
    }
  ]
}
